<%- include("partials/header.ejs") %>

    <div class="d-flex align-items-center justify-content-center" style="height: 68vh; width: 100vw;">

        <form action="/register" method="POST">
            <h1 class="h3 mb-3 fw-normal">Please make an account</h1>

            <div class="form-floating mb-3">

                <input 
                    type="text" 
                    class="form-control <%= flash?.errors?.username ? 'is-invalid' : '' %>"
                    value="<%= flash?.oldInput?.username || '' %>" 
                    name="username" 
                    id="floatingInput" 
                    placeholder="Username"
                    required
                >
                <label for="floatingInput">
                    Username
                </label>

                <div class="invalid-feedback">
                    <%= flash?.errors?.username %>
                </div>

            </div>

            <div class="form-floating mb-3">

                <input 
                    type="password" 
                    class="form-control <%= flash?.errors?.password ? 'is-invalid' : '' %>" 
                    name="password" 
                    id="floatingPassword" 
                    placeholder="Password"
                    required
                >
                <label for="floatingPassword">
                    Password
                </label>

                <div class="invalid-feedback">
                    <%= flash?.errors?.password %>
                </div>

            </div>

            <div class="form-floating mb-3">

                <input 
                    type="password" 
                    class="form-control <%= flash?.errors?.repeatPassword ? 'is-invalid' : '' %>" 
                    name="repeatPassword" 
                    id="floatingRepeatPassword"
                    placeholder="Repeat password" 
                    required
                >
                <label for="floatingRepeatPassword">
                    Repeat password
                </label>

                <div class="invalid-feedback">
                    <%= flash?.errors?.repeatPassword %>
                </div>

            </div>

            <button class="btn btn-primary w-100 py-2" type="submit">Sign up</button>
        </form>

    </div>

<%- include("partials/footer.ejs") %>