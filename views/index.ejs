<%- include("partials/header.ejs") %>

    <div class="container my-5">
        <div class="row p-4 pb-0 pe-lg-0 pt-lg-5 align-items-center rounded-3 border shadow-lg overflow-hidden">
            <div class="col-lg-7 p-3 p-lg-5 pt-lg-3">
                <h1 class="display-4 fw-bold lh-1 text-body-emphasis">Border hero with cropped image and shadows</h1>
                <p class="lead">Quickly design and customize responsive mobile-first sites with Bootstrap, the world’s
                    most popular front-end open source toolkit, featuring Sass variables and mixins, responsive grid
                    system, extensive prebuilt components, and powerful JavaScript plugins.</p>
                <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-4 mb-lg-3">
                    <button type="button" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">
                        Primary
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-lg px-4">
                        Default
                    </button>
                </div>
            </div>
            <div class="col-lg-4 offset-lg-1 p-0 overflow-hidden shadow-lg">
                <img class="rounded-lg-3" src="images/Header.webp" alt="" width="700">
            </div>
        </div>
    </div>

    <div class="container">
        <% blogData.forEach((blog, index)=> { %>
            <% if (index % 2===0) { %>
                <div class="row mb-2 g-3">
            <% } %>

                        <div class="col-md-6">
                            <div
                                class="row g-0 border rounded overflow-hidden flex-md-row mb-4 shadow-sm h-md-250 position-relative">
                                <div class="col p-4 d-flex flex-column position-static">
                                    <strong class="d-inline-block mb-2 text-primary-emphasis">
                                        <%= blog.subject %>
                                    </strong>
                                    <h3 class="mb-0">
                                        <% const truncatedTitle=truncateText(blog.title, 25); %>
                                            <%= truncatedTitle %>
                                    </h3>
                                    <div class="mb-1 text-body-secondary">
                                        <% const formattedDate=new Date(blog.date).toLocaleDateString('en-US', {
                                            month: 'short' , day: 'numeric' }); %>
                                            <%= formattedDate %>
                                    </div>
                                    <div class="mb-1 text-secondary-emphasis"> by <%= blog.user %>
                                    </div>
                                    <p class="card-text mb-auto">
                                        <% const truncatedText=truncateText(blog.text); %>
                                            <%= truncatedText %>
                                    </p>
                                    <a href="#" class="icon-link gap-1 icon-link-hover stretched-link">
                                        Continue reading
                                        <svg class="bi" aria-hidden="true">
                                            <use xlink:href="#chevron-right"></use>
                                        </svg>
                                    </a>
                                </div>
                                <div class="col-auto d-none d-lg-block">
                                    <img src="<%= blog.imageURL %>" height="250" width="200" alt="">
                                </div>
                            </div>
                        </div>

            <% if (index % 2===1) { %>
                </div>
            <% } %>
        <% });%>

    </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous">
        </script>

    <%- include("partials/footer.ejs") %>