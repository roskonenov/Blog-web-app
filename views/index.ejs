<%- include("partials/header.ejs") %>

    <div class="container my-5" style="min-height: 65vh;">

        <% if (blogData.length > 0) { %>

            <div class="row p-4 pb-0 pe-lg-0 pt-lg-5 align-items-center rounded-3 border shadow-lg overflow-hidden">
                <div class="col-lg-7 p-3 p-lg-5 pt-lg-3">
                    <strong class="d-inline-block mb-4 text-primary-emphasis">Latest blog</strong>

                    <% const latestBlog = blogData[blogData.length - 1]; %>
                    <% const latestTruncateTitle = truncateText(latestBlog.title, 40); %>

                    <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-4">
                        <%- locals.query ? highlightedText(latestTruncateTitle, query) : latestTruncateTitle %>
                    </h1>
                    <h2 class="mb-1 text-secondary-emphasis"> by <%= latestBlog.user %> </h2>

                    <% const latestTruncateText = truncateText(latestBlog.text, 300); %>

                    <p class="lead my-5"> 
                        <%- locals.query ? highlightedText(latestTruncateText, query) : latestTruncateText %> 
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-4 mb-lg-3">
                        <a href="/blog/<%= latestBlog.id %>" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold">
                            Read
                        </a>
                    </div>
                </div>

                <div class="col-lg-4 offset-lg-1 p-0 overflow-hidden shadow-lg">
                    <img 
                    class="rounded-lg-3 img-fluid float-end" 
                    src="<%= latestBlog.imageURL.startsWith('http') ? latestBlog.imageURL : '/' + latestBlog.imageURL %>" 
                    alt="" height="300">
                </div>
            </div> 

        <% } else { %>
            <div class="alert alert-warning text-center m-0">
                    No Data
            </div>
        <% } %>
        
    </div>

<div class="container">
    <% blogData.forEach((blog, index)=> { %>

        <% if (index % 2 === 0) { %>
            <div class="row mb-2 g-3">
        <% } %>

                <div class="col-md-6">
                    <div class="row g-0 border rounded overflow-hidden flex-md-row mb-4 shadow-sm h-md-250 position-relative">
                        <div class="col p-4 d-flex flex-column position-static">
                            <strong class="d-inline-block mb-2 text-primary-emphasis">

                                <%= blog.subject %>
                                
                            </strong>
                            <h3 class="mb-0">

                                <% const truncatedTitle = truncateText(blog.title, 25); %>
                                <%- locals.query ? highlightedText(truncatedTitle, query) : truncatedTitle %>

                            </h3>
                            <div class="mb-1 text-body-secondary">

                                <% const formattedDate = new Date(blog.date).toLocaleDateString('en-US', {
                                    month: 'short' , day: 'numeric' }); %>

                                <%= formattedDate %>

                            </div>
                            <div class="mb-1 text-secondary-emphasis"> by <%= blog.user %></div>
                            <p class="card-text mb-auto">

                                <% const truncatedText = truncateText(blog.text, 95); %>
                                <%- locals.query ? highlightedText(truncatedText, query) : truncatedText %>

                            </p>
                            <a href="/blog/<%= blog.id %>" class="icon-link gap-1 icon-link-hover stretched-link">
                                Continue reading
                                <svg class="bi" aria-hidden="true">
                                    <use xlink:href="#chevron-right"></use>
                                </svg>
                            </a>
                        </div>
                        <div class="col-auto d-none d-lg-block">
                            <img 
                            src="<%= blog.imageURL.startsWith('http') ? blog.imageURL : '/' + blog.imageURL %>" 
                            height="250" 
                            width="200" 
                            alt="">
                        </div>
                    </div>
                </div>

        <% if (index % 2 === 1) { %>
            </div>
        <% } %>
    <% });%>

</div>


<%- include("partials/footer.ejs") %>